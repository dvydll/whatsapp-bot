# WhatsAppBot Environment Variables
# Copia este archivo a .env y completa los valores

# Configuración del Bot
BOT_NAME=WhatsAppBot
OWNER_JID=tu_numero@lid
BOT_PREFIX=#,/'

# API (obtén tu key en api.naufrabot.com)
NAUFRA_KEY=tu_api_key_aqui

# Configuración
TIMEZONE=America/Lima
LOG_LEVEL=info

# Node
NODE_ENV=development
