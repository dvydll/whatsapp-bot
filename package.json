{
  "name": "whatsapp-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "WhatsApp Bot con arquitectura moderna",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
